import os
from Jenga import *
from Jenga.GlobalToolchains import RegisterJengaGlobalToolchains

with workspace("ExternalIncludesDemo"):
    # Config partagee chargee depuis un SOUS-DOSSIER (chemin explicite), propagee
    # a tout le workspace + a TOUS les .jenga inclus via include(), sans aucun
    # `import`. Fichier .jenga (on reste dans le contexte Jenga). Plusieurs
    # fichiers possibles : useconfig("cfg/a.jenga", "cfg/b.jenga").
    useconfig("cfg/shared.jenga")

    RegisterJengaGlobalToolchains()
    configurations(["Debug", "Release"])
    targetoses([
        TargetOS.WINDOWS,
        TargetOS.LINUX,
        TargetOS.ANDROID,
        TargetOS.WEB,
    ])
    targetarchs([TargetArch.X86_64, TargetArch.ARM64, TargetArch.WASM32])

    # Android SDK/NDK paths
    androidsdkpath(os.getenv("ANDROID_SDK_ROOT", ""))
    androidndkpath(os.getenv("ANDROID_NDK_ROOT", os.getenv("ANDROID_NDK_HOME", "")))

    with include("libs/logger.jenga"):
        pass

    with include("libs/math.jenga"):
        pass

    with project("App"):
        consoleapp()
        language("C++")
        cppdialect(SHARED_CPP_DIALECT)   # <- constante de config.py (usage workspace)
        files(["src/main.cpp"])
        includedirs(["libs/logger/include", "libs/math/include"])
        links(["Logger", "MathLib"])
        dependson(["Logger", "MathLib"])

        # Windows
        with filter("system:Windows"):
            usetoolchain("clang-mingw")

        # Linux
        with filter("system:Linux"):
            usetoolchain("zig-linux-x64")

        # Android
        with filter("system:Android"):
            usetoolchain("android-ndk")
            androidapplicationid("com.jenga.externalincludes")
            androidminsdk(24)
            androidtargetsdk(34)
            androidabis(["arm64-v8a", "x86_64"])

        # Web
        with filter("system:Web"):
            usetoolchain("emscripten")
            emscripteninitialmemory(16)
